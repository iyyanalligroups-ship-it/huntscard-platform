# Copy to .env. This tool runs LOCALLY on the machine physically connected
# to the ACR1252U -- it is never deployed to a server.

# Only used by the legacy terminal tool (encode.js / `npm start`), which
# still connects to MongoDB directly and isn't part of the packaged
# Electron app. The GUI/Electron version (gui-server.js) doesn't use
# this at all -- it goes through the backend API instead. Leave blank
# if you're only ever using the GUI/Electron version.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/intro?retryWrites=true&w=majority

# These two values are now normally set from the app's own Settings
# screen (gear icon), not from this file -- they're saved to a local
# config file per install and survive restarts. The values below are
# only used to SEED the very first run if no settings have been saved
# yet (e.g. convenient for local development). Once Settings has been
# saved once, this file is ignored for these two values.
PUBLIC_BASE_URL=https://huntstag.com

# The running backend API -- this tool logs in as an admin against it
# before it will write to any card. Point at localhost while developing.
BACKEND_URL=http://localhost:4000
