{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.huntstag.com",
        "EXPO_PUBLIC_WEB_URL": "https://huntstag.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.huntstag.com",
        "EXPO_PUBLIC_WEB_URL": "https://huntstag.com"
      }
    }
  }
}