# SEO rules to merge into the existing server block for huntstag.com (nginx on the VPS).
# This is an example: adjust root, ports and paths to match the current config. Nothing here is deployed.
#
#   root  = the folder with the built client app (client-app/dist)
#   4000  = the backend port (server.js, PORT)

# 0. COMPRESSION -- the Lighthouse reports show app.js (578 KiB) and the stylesheet (528 KiB) are sent
#    uncompressed. nginx only compresses text/html unless told otherwise. Put this in the http { } block
#    (or the server block). It cuts the JavaScript to about 180 KiB and the CSS to about 85 KiB.
gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types text/css text/plain text/javascript application/javascript application/json
           application/manifest+json application/xml image/svg+xml;
# If the brotli module is installed (nginx -V | grep brotli), also add:
#   brotli on;  brotli_comp_level 5;
#   brotli_types text/css text/plain text/javascript application/javascript application/json image/svg+xml;

# 1. Dynamic sitemap from the backend (cached ~10 minutes there).
#    If the backend is down, nginx serves the static copy built into dist/sitemap.xml.
location = /sitemap.xml {
    proxy_pass http://127.0.0.1:4000/sitemap.xml;
    proxy_set_header Host $host;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @static_sitemap;
}
location @static_sitemap {
    root /var/www/huntstag/client-app/dist;   # <- same root as the site
    try_files /sitemap.xml =404;
}

# 2. robots.txt is a plain file.
location = /robots.txt {
    try_files /robots.txt =404;
}

# 3. Hashed build files (names like index-DaLvZr4p.js) never change, so browsers can keep them for a year.
#    This must stay ABOVE the next rule: nginx uses the first matching regex location.
location ~* "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css)$" {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# 4. Missing files must return 404, not the home page.
#    Anything that looks like a file (has an extension) is never sent to index.html.
location ~* \.(?:js|css|map|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|mp4|webm|json|xml|txt|glb|mind|crt)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=604800";
}

# 5. App pages (React Router).
#    - Public pages: `npm run build` writes dist/<path>/index.html with that page's own title, tags and text.
#    - Everything else (login, dashboard, /c/... profiles, unknown addresses): dist/app-shell.html,
#      a plain page marked noindex. A single-page app cannot send a real 404 for these; the app shows its
#      own "Page not found" screen for unknown addresses.
location / {
    try_files $uri $uri/index.html /app-shell.html;
    add_header Cache-Control "no-cache";   # pages are re-checked every visit; hashed files above are cached for a year
}

# 6. HSTS -- tells browsers to use https only (Semrush: "2 subdomains don't support HSTS").
#    Add this line to the server block of EACH site: huntstag.com / www.huntstag.com AND api.huntstag.com.
#    Start with a short time, check that everything still loads over https, then raise it (31536000 = 1 year).
#    Do not add includeSubDomains or preload until every subdomain works over https.
#    add_header Strict-Transport-Security "max-age=300" always;
