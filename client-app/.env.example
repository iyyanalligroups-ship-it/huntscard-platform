VITE_API_URL=http://localhost:4000

# Business details shown on the public site. Leave blank to hide each item.
VITE_DEMO_PROFILE_URL=           # sample profile path, e.g. /c/yourname
VITE_WHATSAPP_NUMBER=            # digits only, e.g. 919876543210
VITE_FROM_PRICE=                 # lowest card price, e.g. 399
VITE_DELIVERY_TIME=              # e.g. "3-5 days"
VITE_FREE_PREVIEW=false          # true only if you really offer it
VITE_CARDS_DELIVERED=            # e.g. "100+" (real numbers only)
VITE_PHONE=
VITE_BUSINESS_ADDRESS=
VITE_GST_NUMBER=
VITE_GA_ID=                      # Google Analytics 4, e.g. G-XXXXXXX
VITE_META_PIXEL_ID=
