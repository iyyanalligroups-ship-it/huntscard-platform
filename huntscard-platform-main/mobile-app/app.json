{
  "expo": {
    "name": "HuntsAR World",
    "slug": "huntsar-world",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "huntsarworld",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huntstag.huntsarworld"
    },
    "android": {
      "package": "com.huntstag.huntsarworld",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "HuntsAR World needs your camera to scan a HuntsTAG's QR code."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "HuntsAR World uses your camera to show AR content for scanned HuntsTAG cards.",
            "microphoneUsagePermission": "HuntsAR World does not currently use audio, but ViroReact requires this permission string to build.",
            "photosPermission": "HuntsAR World would like to read photos for AR experiences.",
            "savePhotosPermission": "HuntsAR World would like to save photos to your library during AR experiences."
          },
          "googleCloudApiKey": "Your Google Cloud API Key",
          "provider": "reactvision",
          "rvApiKey": "Add your API key here",
          "rvProjectId": "Add your project ID here"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
