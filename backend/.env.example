# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# MongoDB Atlas connection string (create a free cluster, get this from Atlas UI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/intro?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# How long a login session lasts before needing to log in again
JWT_EXPIRES_IN=1h

# Public base URL used to build each client's tap/QR link. This is
# client-app's own public domain (it owns the /c/:clientId page), NOT this
# backend's own URL -- e.g. https://huntstag.com, not https://api.huntstag.com.
PUBLIC_BASE_URL=http://localhost:5173

# This backend's own public URL -- used to build links to files IT serves
# (uploaded photos/videos/models/icons under /uploads/...). Must be this
# server's own reachable address, e.g. https://api.huntstag.com in
# production, NOT client-app's domain (that's PUBLIC_BASE_URL, above) --
# client-app has no /uploads route of its own.
BACKEND_URL=http://localhost:4000

# Razorpay keys (dashboard.razorpay.com -> Settings -> API Keys). Without
# these, the Shop's checkout routes return 503 "Payments are not configured
# yet" -- everything else in the app still works fine.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# Activity backup to Google Drive (admin panel -> Activity Backups). Create an OAuth "Web application" client in
# Google Cloud Console, enable the Google Drive API, and use ONLY the drive.file scope. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if the public API address is different from BACKEND_URL. Must match the redirect URI added in
# Google Cloud exactly. Default: <BACKEND_URL>/api/admin/activity-backup/google/callback
GOOGLE_REDIRECT_URI=
# Where Google sends the admin back to after connecting (the admin panel's own address, no trailing slash).
ADMIN_PANEL_URL=http://localhost:5174
# Optional: name of the top folder created in Drive (default HuntsTAG).
# ACTIVITY_BACKUP_DRIVE_ROOT=HuntsTAG
# Optional: set to off to switch the hourly backup check off on this server.
# ACTIVITY_BACKUP_SCHEDULER=off
