# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# MongoDB Atlas connection string (create a free cluster, get this from Atlas UI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/intro?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# How long a login session lasts before needing to log in again
JWT_EXPIRES_IN=1h

# Public base URL used to build each client's tap/QR link, e.g. https://huntscard.in
PUBLIC_BASE_URL=http://localhost:4000

# Razorpay keys (dashboard.razorpay.com -> Settings -> API Keys). Without
# these, the Shop's checkout routes return 503 "Payments are not configured
# yet" -- everything else in the app still works fine.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
